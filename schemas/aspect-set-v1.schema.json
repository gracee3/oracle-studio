{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracle-studio.invalid/schemas/aspect-set-v1.schema.json",
  "title": "Oracle Studio aspect set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "name",
    "description",
    "built_in",
    "rules",
    "points",
    "content_id"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128,
      "pattern": "^(builtin|user)\\.[a-z0-9.-]+$"
    },
    "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "built_in": { "type": "boolean" },
    "rules": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rule" },
      "allOf": [
        { "contains": { "properties": { "kind": { "const": "conjunction" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "kind": { "const": "opposition" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "kind": { "const": "square" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "kind": { "const": "trine" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "kind": { "const": "sextile" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "display_order": { "const": 0 } }, "required": ["display_order"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "display_order": { "const": 1 } }, "required": ["display_order"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "display_order": { "const": 2 } }, "required": ["display_order"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "display_order": { "const": 3 } }, "required": ["display_order"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "display_order": { "const": 4 } }, "required": ["display_order"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sun", "moon", "mercury", "venus", "mars", "jupiter", "saturn",
          "uranus", "neptune", "pluto", "mean_node", "true_node",
          "mean_south_node", "true_south_node", "ascendant", "midheaven",
          "descendant", "imum_coeli", "vertex"
        ]
      }
    },
    "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "enabled", "orbs", "display_order"],
      "properties": {
        "kind": { "enum": ["conjunction", "opposition", "square", "trine", "sextile"] },
        "enabled": { "type": "boolean" },
        "orbs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "luminary_applying_degrees",
            "luminary_separating_degrees",
            "other_applying_degrees",
            "other_separating_degrees"
          ],
          "properties": {
            "luminary_applying_degrees": { "type": "number", "minimum": 0, "maximum": 30 },
            "luminary_separating_degrees": { "type": "number", "minimum": 0, "maximum": 30 },
            "other_applying_degrees": { "type": "number", "minimum": 0, "maximum": 30 },
            "other_separating_degrees": { "type": "number", "minimum": 0, "maximum": 30 }
          }
        },
        "display_order": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    }
  }
}
